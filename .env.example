# ---------- Discord ----------
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) ID — used to register slash commands
DISCORD_APP_ID=
# Guild to register commands in (instant registration; leave blank for global/1h propagation)
DISCORD_GUILD_ID=
# Channel the bot watches for clips
CLIPS_CHANNEL_ID=
# Channel where the bot announces finished reels (defaults to CLIPS_CHANNEL_ID)
ANNOUNCE_CHANNEL_ID=
# Comma-separated role IDs allowed to run /reel commands (blank = Manage Server perm)
ADMIN_ROLE_IDS=

# ---------- Trigger ----------
# Compile as soon as this many unique pending clips exist
REEL_MAX_CLIPS=20
# Weekly cron also fires, but only if at least this many clips are pending
REEL_MIN_CLIPS=5
# Node-cron expression, server local time. Default: Sunday 18:00
REEL_CRON=0 18 * * 0
TZ=UTC

# ---------- Video ----------
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080
OUTPUT_FPS=30
# Crossfade length in seconds between clips
TRANSITION_DURATION=0.5
# xfade transition names, comma separated; picked round-robin
TRANSITIONS=fade,wipeleft,slideup,circleopen,dissolve
# Hard cap per clip (seconds); longer clips are trimmed
MAX_CLIP_SECONDS=60
# Skip clips shorter than this
MIN_CLIP_SECONDS=2
# Burn "@author" label over the first seconds of each clip
TITLE_CARDS=true
TITLE_CARD_SECONDS=3
# Optional TTF used for the label. Leave blank to auto-detect a system font.
FONT_FILE=
# x264 preset / quality
X264_PRESET=veryfast
X264_CRF=20

# ---------- Ingest ----------
# Max bytes to download per clip (default 500MB)
MAX_DOWNLOAD_BYTES=524288000
# Also accept links (Medal, Streamable, Twitch clips, YouTube). Requires yt-dlp on PATH.
ALLOW_LINKS=true
# Hamming distance under which two clips are considered the same video
PHASH_THRESHOLD=8

# ---------- YouTube ----------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Produced by `npm run youtube:auth`
YOUTUBE_REFRESH_TOKEN=
# private | unlisted | public — see README, unverified API projects are forced to private
YOUTUBE_PRIVACY=private
# Publish straight to YOUTUBE_PRIVACY, or wait for the Discord approve button
YOUTUBE_AUTO_PUBLISH=false
YOUTUBE_TITLE_TEMPLATE=Best Gaming Clips #{n} — {month} {year}
YOUTUBE_TAGS=gaming,clips,funny moments,montage
YOUTUBE_CATEGORY_ID=20

# Override the bundled ffmpeg/ffprobe binaries, or point at a yt-dlp outside PATH
FFMPEG_PATH=
FFPROBE_PATH=
YTDLP_PATH=
# Must match an authorized redirect URI on the OAuth client
YOUTUBE_REDIRECT_URI=http://localhost:8787/oauth2callback

# ---------- Misc ----------
LOG_LEVEL=info
DATA_DIR=./data
# Delete source clip files once a reel is uploaded
CLEANUP_SOURCES=false
