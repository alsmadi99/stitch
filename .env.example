# ---------- Discord ----------
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) ID — used to register slash commands
DISCORD_APP_ID=
# Guild to register commands in (instant registration; leave blank for global/1h propagation)
DISCORD_GUILD_ID=
# Channel the bot watches for clips
CLIPS_CHANNEL_ID=
# Channel where the bot announces finished reels (defaults to CLIPS_CHANNEL_ID)
ANNOUNCE_CHANNEL_ID=
# Comma-separated Discord USER IDs allowed to run the privileged commands
# (/reel build, /reel publish). Leave blank and those commands are not registered at
# all — the safest default, since they upload videos and spend YouTube quota.
# Backfill is deliberately not exposed to Discord; run it from the server terminal.
ADMIN_USER_IDS=
# Comma-separated role IDs allowed to run the read-only /clips status
# (blank = anyone with Manage Server)
ADMIN_ROLE_IDS=
# React with any of these on a clip to pull it out of the queue; remove it to undo.
# Several crosses are listed because clients disagree on which one \:x\: produces.
REJECT_REACTION=❌,✖️,❎
# Who the veto reaction listens to. Restrictive by default; widening is opt-in.
#   owner   - only ADMIN_USER_IDS, nobody else
#   admins  - plus ADMIN_ROLE_IDS, or anyone with Manage Server if no roles are listed
#   authors - plus the person who posted the clip, so people can withdraw their own
VETO_ALLOWED=owner

# ---------- Trigger ----------
# Compile as soon as this many unique pending clips exist
REEL_MAX_CLIPS=20
# Weekly cron also fires, but only if at least this many clips are pending
REEL_MIN_CLIPS=5
# Node-cron expression, server local time. Default: Sunday 18:00
REEL_CRON=0 18 * * 0
TZ=UTC

# ---------- Video ----------
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080
OUTPUT_FPS=30
# Crossfade length in seconds between clips
TRANSITION_DURATION=0.5
# xfade transition names, comma separated; picked round-robin
TRANSITIONS=fade,wipeleft,slideup,circleopen,dissolve
# Hard cap per clip (seconds); longer clips are trimmed
MAX_CLIP_SECONDS=60
# Skip clips shorter than this
MIN_CLIP_SECONDS=2
# Burn an "@author" credit over the first seconds of each clip
TITLE_CARDS=false
TITLE_CARD_SECONDS=3
# Optional TTF used for the label. Leave blank to auto-detect a system font.
FONT_FILE=
# x264 preset / quality
X264_PRESET=veryfast
X264_CRF=20
# Cap ffmpeg's own threads. 0 = one per core, which will saturate a small VPS.
FFMPEG_THREADS=0
# Segments folded together per ffmpeg call. This is the memory dial: one call holding
# all 20 clips open needs ~4.5GB at 1080p. Measured peak RSS at 1080p is roughly
# 1.0GB at 3, 1.2GB at 4, 1.45GB at 5; 720p is about half that.
STITCH_BATCH=4

# ---------- Thumbnail ----------
# Big label burned across the bottom of the generated thumbnail
THUMBNAIL_LABEL=GAMING CLIPS
# Accent colour for the episode badge and stripe. Use 0xRRGGBB, not #RRGGBB — dotenv
# treats an unquoted # as a comment and would leave this empty.
THUMBNAIL_ACCENT=0xE62117

# ---------- Ingest ----------
# Max bytes to download per clip (default 200MB)
MAX_DOWNLOAD_BYTES=209715200
# Also accept links (Medal, Streamable, Twitch clips, YouTube). Requires yt-dlp on PATH.
ALLOW_LINKS=true
# Hamming distance under which two clips are considered the same video
PHASH_THRESHOLD=8
# Clips downloaded at once. Keep at 1-2 on a small host.
INGEST_CONCURRENCY=2
# Refuse to start a download when the data volume has less free space than this
MIN_FREE_DISK_MB=2048
# Hard cap on reels per backfill run. 0 = unlimited, which is the default: the run is
# bounded by MAX_PENDING_UPLOADS and the daily quota instead.
BACKFILL_MAX_REELS=0
# How many finished-but-not-yet-uploaded reels may pile up before the scan pauses.
# Each one sits on disk until the quota lets it out, so this is the disk dial.
MAX_PENDING_UPLOADS=3
# Resume a backfill that stopped on the quota, automatically, once uploads drain.
# Turns "deploy the whole history" into one command rather than one per day.
BACKFILL_AUTO_CONTINUE=true

# ---------- YouTube ----------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Produced by `npm run youtube:auth`
YOUTUBE_REFRESH_TOKEN=
# The privacy an upload gets — but ONLY when YOUTUBE_AUTO_PUBLISH=true.
# With AUTO_PUBLISH=false every upload is private regardless of what this says.
YOUTUBE_PRIVACY=private
# false: always upload private; publishing is a separate, deliberate act.
# true:  upload straight at YOUTUBE_PRIVACY. Setting this true with PRIVACY=public
#        means every reel is public the instant it finishes uploading.
YOUTUBE_AUTO_PUBLISH=false
# Quotes are required: dotenv would otherwise treat the # in #{n} as a comment and
# silently drop the episode number from every title.
YOUTUBE_TITLE_TEMPLATE="Discord Gaming Clips #{n} | CS2, Rocket League, LoL & More"
# Games named in the description. Purely cosmetic — nothing detects the actual game.
YOUTUBE_GAMES=CS2,Rocket League,League of Legends,Rust,Valorant,Fortnite,GTA V,Minecraft,Apex Legends,Call of Duty
# Hashtags appended to the description. YouTube counts title and description hashtags
# together and ignores ALL of them past 15, so the "#{n}" in the title reserves a slot
# and this list is truncated to fit whatever is left.
YOUTUBE_HASHTAGS=gaming,funny,clips,arabic,cs2,rocketleague,leagueoflegends,rust,valorant,fortnite,gameplay,montage,fails,highlights
# Search keywords. YouTube caps the combined length at 500 characters.
YOUTUBE_TAGS=gaming clips,funny gaming moments,variety gaming,cs2 clips,counter strike 2,rocket league clips,league of legends clips,rust clips,valorant clips,fortnite clips,gaming montage,discord clips,funny fails,gaming highlights,arabic gaming,العاب,كليبات جيمنج,gameplay,best moments
# Optional: replace the generated description wholesale. A literal backslash-n in
# the value becomes a line break. Avoid putting escape sequences in comments here:
# Docker Compose parses this file more strictly than dotenv does.
YOUTUBE_DESCRIPTION=
YOUTUBE_CATEGORY_ID=20
# Add every uploaded reel to a playlist. Set the ID directly, or give a title and the
# bot finds or creates a playlist with that name and remembers it. Leave both blank to
# disable. Enabling it later backfills videos that were already uploaded.
YOUTUBE_PLAYLIST_ID=
YOUTUBE_PLAYLIST_TITLE=Discord Gaming Clips
# Playlist visibility. The videos inside keep their own privacy regardless.
YOUTUBE_PLAYLIST_PRIVACY=public

# Override the bundled ffmpeg/ffprobe binaries, or point at a yt-dlp outside PATH
FFMPEG_PATH=
FFPROBE_PATH=
YTDLP_PATH=
# Must match an authorized redirect URI on the OAuth client
YOUTUBE_REDIRECT_URI=http://localhost:8787/oauth2callback

# ---------- Misc ----------
# Port for the /health status endpoint. Set to 0 to disable it entirely.
HTTP_PORT=3000
LOG_LEVEL=info
DATA_DIR=./data
# Delete source clip files once a reel is uploaded
CLEANUP_SOURCES=false
