# Dependencies
node_modules/
.npm/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Secrets. .env.example is the tracked template and must stay tracked.
.env
.env.*
!.env.example

# Runtime state: SQLite database, downloaded clips, work files, finished reels,
# heartbeat. The whole directory is ignored rather than its subdirectories, so
# anything new written at the top of data/ is covered automatically.
data/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scratch and test output
.smoke/
.chk/
.hb/
.mock/
.rectest/
.jt/
.jg/
.rt/
.realtest/
.tmp/
tmp/
coverage/
*.local

# Editors
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

.*/**

# Scratch dot-directories, but never GitHub's own config: `.*/**` on its own silently
# swallows .github/, so workflows and issue templates could never be committed.
!.github/
!.github/**
# Local test corpora (downloaded clips, scratch databases). Never committed.
.testdata/
